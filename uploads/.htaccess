# Deny all direct web access to the uploads directory.
#
# Student submissions are private: they must only be served through
# download.php, which verifies the requester is allowed to read that file.
# Without this rule anyone could read every submission by guessing a URL.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
