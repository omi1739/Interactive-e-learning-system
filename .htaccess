# ==============================================================
#  Interactive e-Learning System - Apache/LiteSpeed configuration
# ==============================================================
#  Deliberately kept small: the previous version used RedirectMatch,
#  which some LiteSpeed builds (including ByetFree) reject and turn
#  into a 500 for the whole site. Access control is now done with
#  per-directory .htaccess files instead (see config/, includes/,
#  install/, database/, logs/, uploads/).

# No directory listings.
Options -Indexes

# --------------------------------------------------------------
# Security response headers
# --------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
</IfModule>