# Never serve the local configuration file: it holds database credentials.
# If this file is ever downloadable, every visitor can read your DB password.

<Files "local.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>
